rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. User Public Profiles (/users/{userId})
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // 2. User Private Settings (/users_private/{userId})
    match /users_private/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 3. Usernames Reservation (/usernames/{username})
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // 4. One-on-One Chats & Messages (/chats/{chatId})
    match /chats/{chatId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.participant1Uid == request.auth.uid ||
        resource.data.participant2Uid == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.participant1Uid == request.auth.uid ||
        request.resource.data.participant2Uid == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.participant1Uid == request.auth.uid ||
        resource.data.participant2Uid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.participant1Uid == request.auth.uid ||
        resource.data.participant2Uid == request.auth.uid
      );

      // Chat Messages Subcollection (/chats/{chatId}/messages/{messageId})
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.senderId == request.auth.uid ||
          resource.data.recipientId == request.auth.uid
        );
        allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    // 5. Group Chats & Group Messages (/groups/{groupId})
    match /groups/{groupId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // 6. WebRTC Voice and Video Calling Signaling (/calls/{callId})
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.callerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.callerUid == request.auth.uid ||
        resource.data.calleeUid == request.auth.uid
      );

      // WebRTC ICE Candidate Subcollections
      match /callerCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }

      match /calleeCandidates/{candidateId} {
        allow read, write: if isSignedIn();
      }
    }

    // 7. Friendships & Friend Requests
    match /friends/{friendId} {
      allow read, write: if isSignedIn();
    }

    match /friend_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // 8. Notifications (/notifications/{notificationId})
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.recipientUid == request.auth.uid ||
        resource.data.actorUid == request.auth.uid
      );
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        resource.data.recipientUid == request.auth.uid ||
        resource.data.actorUid == request.auth.uid
      );
    }

    // 9. Stories (/stories/{storyId})
    match /stories/{storyId} {
      allow read, write: if isSignedIn();
    }

    // 10. End-to-End Encryption Device Public Keys (/e2ee_keys/{userId})
    match /e2ee_keys/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 11. User Blocks & Abuse Reports
    match /blocks/{blockId} {
      allow read, write: if isSignedIn();
    }

    match /reports/{reportId} {
      allow read, write: if isSignedIn();
    }

    // 12. Test connection ping document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
