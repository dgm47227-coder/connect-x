          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "replyToText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["sent", "delivered", "read"]
        },
        "isDeleted": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "messageId",
        "chatId",
        "senderId",
        "recipientId",
        "text",
        "mediaUrl",
        "mediaType",
        "replyToMessageId",
        "replyToText",
        "status",
        "isDeleted",
        "createdAt",
        "updatedAt"
      ]
