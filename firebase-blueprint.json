    "AbuseReport": {
      "title": "AbuseReport",
      "description": "User safety report for abusive profiles, messages, or stories.",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
