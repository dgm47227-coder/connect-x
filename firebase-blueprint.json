{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Publicly discoverable user profile information without PII.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$",
          "description": "Unique lowercase handle."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Public display name."
        },
        "bio": {
          "type": "string",
          "minLength": 0,
          "maxLength": 250,
          "description": "User biography."
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000,
          "description": "Profile avatar URL or SVG data URI."
        },
        "friendsCount": {
          "type": "integer",
          "description": "Count of accepted friendships."
        },
        "privacyWhoCanRequest": {
          "type": "string",
          "enum": ["everyone", "none"],
          "description": "Controls who can send friend requests."
        },
        "privacyStoryAudience": {
          "type": "string",
          "enum": ["friends", "public"],
          "description": "Default story audience."
        },
        "privacyShowReadReceipts": {
          "type": "boolean",
          "description": "Whether read receipts are shared."
        },
        "privacyShowOnlineStatus": {
          "type": "boolean",
          "description": "Whether online presence is visible."
        },
        "isPublicProfile": {
          "type": "boolean",
          "description": "Whether profile can be listed in discovery queries."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "username",
        "displayName",
        "bio",
        "avatarUrl",
        "friendsCount",
        "privacyWhoCanRequest",
        "privacyStoryAudience",
        "privacyShowReadReceipts",
        "privacyShowOnlineStatus",
        "isPublicProfile",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateSettings": {
      "title": "UserPrivateSettings",
      "description": "Isolated PII and private notification preferences accessible only to the account owner.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "notificationPreviewEnabled": {
          "type": "boolean"
        },
        "notifyFriendRequests": {
          "type": "boolean"
        },
        "notifyMessages": {
          "type": "boolean"
        },
        "notifyStories": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "notificationPreviewEnabled",
        "notifyFriendRequests",
        "notifyMessages",
        "notifyStories",
        "createdAt",
        "updatedAt"
      ]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Maps a unique username to an owner UID.",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-z0-9_]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["username", "uid", "createdAt"]
    },
    "FriendRequest": {
      "title": "FriendRequest",
      "description": "Directed friend request between two users.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "fromDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "fromAvatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "toDisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "toAvatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "rejected", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requestId",
        "fromUid",
        "fromUsername",
        "fromDisplayName",
        "fromAvatarUrl",
        "toUid",
        "toUsername",
        "toDisplayName",
        "toAvatarUrl",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Accepted mutual friendship record with deterministic ID.",
      "type": "object",
      "properties": {
        "friendshipId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "user1Uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "user2Uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "user1Username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "user2Username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "user1DisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "user2DisplayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "user1AvatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "user2AvatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["active"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "friendshipId",
        "user1Uid",
        "user2Uid",
        "user1Username",
        "user2Username",
        "user1DisplayName",
        "user2DisplayName",
        "user1AvatarUrl",
        "user2AvatarUrl",
        "status",
        "createdAt"
      ]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "One-to-one private conversation metadata with deterministic ID.",
      "type": "object",
      "properties": {
        "chatId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participant1Uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participant2Uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participant1Name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "participant2Name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "participant1Username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "participant2Username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30
        },
        "participant1Avatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "participant2Avatar": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "lastMessageText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "lastMessageSenderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "lastMessageStatus": {
          "type": "string",
          "enum": ["sent", "delivered", "read"]
        },
        "unreadCount1": {
          "type": "integer"
        },
        "unreadCount2": {
          "type": "integer"
        },
        "typingUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
