        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "reportId",
        "reporterUid",
        "targetUid",
        "targetType",
        "reasonCategory",
        "details",
        "status",
        "createdAt"
      ]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "In-app notification record for a target user.",
      "type": "object",
      "properties": {
        "notificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
