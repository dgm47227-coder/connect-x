      "required": [
        "chatId",
        "participant1Uid",
        "participant2Uid",
        "participant1Name",
        "participant2Name",
        "participant1Username",
        "participant2Username",
        "participant1Avatar",
        "participant2Avatar",
        "lastMessageText",
        "lastMessageSenderId",
        "lastMessageStatus",
        "unreadCount1",
        "unreadCount2",
        "typingUid",
        "createdAt",
        "updatedAt"
