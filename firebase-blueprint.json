          "minLength": 1,
          "maxLength": 60
        },
        "viewedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["viewerUid", "storyAuthorUid", "viewerUsername", "viewerDisplayName", "viewedAt"]
    },
    "UserBlock": {
      "title": "UserBlock",
      "description": "User block record preventing messages and requests.",
      "type": "object",
      "properties": {
        "blockId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "blockerUid": {
          "type": "string",
          "minLength": 1,
