      "required": [
        "notificationId",
        "recipientUid",
        "actorUid",
        "actorName",
        "actorUsername",
        "type",
        "previewText",
        "isRead",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "Publicly discoverable user profiles without PII."
    },
    "/users_private/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateSettings" },
      "description": "Owner-only PII and notification preferences."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique username reservation registry."
    },
    "/friendRequests/{requestId}": {
      "schema": { "$ref": "#/entities/FriendRequest" },
      "description": "Pending and resolved friend requests."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Mutual accepted friendships."
    },
    "/chats/{chatId}": {
      "schema": { "$ref": "#/entities/ChatConversation" },
      "description": "Private 1-to-1 chat conversation metadata."
    },
    "/chats/{chatId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages belonging to a private conversation."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/StoryItem" },
      "description": "Ephemeral 24-hour user stories."
    },
    "/stories/{storyId}/views/{viewerUid}": {
      "schema": { "$ref": "#/entities/StoryView" },
      "description": "Story viewer records."
    },
    "/blocks/{blockId}": {
      "schema": { "$ref": "#/entities/UserBlock" },
      "description": "Blocked user pairs."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/AbuseReport" },
      "description": "Abuse and safety reports."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User notification items."
    }
  }
}
